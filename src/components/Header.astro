---
import HeaderLink from './HeaderLink.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, getVisibleSports } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const visibleSports = getVisibleSports(lang);

// Nav structure: some top items open a dropdown; football's dropdown items each
// open a further flyout submenu.
const analysisLbl = t('nav.analysis');
const guidesLbl = t('nav.guides');

const footballGroups = [
  {
    label: t('nav.leagues'),
    href: `/${lang}/football/leagues`,
    items: [
      { label: guidesLbl, href: `/${lang}/football/leagues/guides` },
      { label: analysisLbl, href: `/${lang}/football/leagues/analysis` },
      { label: t('nav.predictions'), href: `/${lang}/football/leagues/predictions` },
      { label: t('nav.verification'), href: `/${lang}/football/leagues/verification` },
      { label: t('nav.trends'), href: `/${lang}/football/leagues/trends` },
    ],
  },
  {
    label: t('nav.worldcup'),
    href: `/${lang}/football/world-cup`,
    items: [
      { label: analysisLbl, href: `/${lang}/football/world-cup/analysis` },
      { label: guidesLbl, href: `/${lang}/football/world-cup/guides` },
      { label: t('nav.bracket'), href: `/${lang}/football/world-cup/bracket` },
      { label: t('nav.groupStage'), href: `/${lang}/football/world-cup/group-stage` },
      { label: t('nav.schedule'), href: `/${lang}/football/world-cup/schedule` },
    ],
  },
];

const simpleDropdowns = [
  { key: 'nba', label: 'NBA', href: `/${lang}/nba`, items: [ { label: guidesLbl, href: `/${lang}/nba/guides` }, { label: analysisLbl, href: `/${lang}/nba` }, { label: t('nav.predictions'), href: `/${lang}/nba/predictions` }, { label: t('nav.trends'), href: `/${lang}/nba/trends` } ] },
  { key: 'cricket', label: t('nav.cricket'), href: `/${lang}/cricket`, items: [ { label: guidesLbl, href: `/${lang}/cricket/guides` }, { label: analysisLbl, href: `/${lang}/cricket` }, { label: t('nav.trends'), href: `/${lang}/cricket/trends` } ] },
].filter((d) => visibleSports.includes(d.key));

const chevronDown = 'm6 9 6 6 6-6';
const chevronRight = 'm9 6 6 6-6 6';
---

<header class="bg-[#0a150f] border-b border-[#3c352c] sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <div class="flex">
        <div class="flex-shrink-0 flex items-center">
          <a href={`/${lang}/`} class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-yellow-600 italic tracking-tighter pr-1">
            THE BIG BET
          </a>
        </div>
        <nav class="hidden md:ml-8 md:flex md:items-center md:space-x-7">
          <HeaderLink href={`/${lang}/`} class="inline-flex items-center px-1 pt-1 text-sm font-bold text-slate-100 hover:text-amber-300 transition-colors duration-200">
            {t('nav.home')}
          </HeaderLink>

          <!-- Football: two-level dropdown -->
          <div class="relative group/fb inline-flex items-center">
            <a href={`/${lang}/football`} class="inline-flex items-center gap-1 px-1 pt-1 text-sm font-bold text-slate-400 hover:text-amber-300 transition-colors duration-200">
              {t('nav.football')}
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevronDown}/></svg>
            </a>
            <div class="absolute left-0 top-full pt-3 hidden group-hover/fb:block group-focus-within/fb:block z-50">
              <div class="bg-[#211d19] border border-[#3c352c] rounded-lg shadow-xl py-2 min-w-[180px]">
                {footballGroups.map((g) => (
                  <div class="relative group/sub">
                    <a href={g.href} class="flex items-center justify-between gap-4 px-4 py-2 text-sm font-bold text-slate-300 hover:text-amber-300 hover:bg-[#3c352c] transition-colors duration-200">
                      {g.label}
                      <svg class="w-3.5 h-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevronRight}/></svg>
                    </a>
                    <div class="absolute left-full top-0 pl-2 hidden group-hover/sub:block group-focus-within/sub:block">
                      <div class="bg-[#211d19] border border-[#3c352c] rounded-lg shadow-xl py-2 min-w-[170px]">
                        {g.items.map((it) => (
                          <a href={it.href} class="block px-4 py-2 text-sm font-bold text-slate-300 hover:text-amber-300 hover:bg-[#3c352c] transition-colors duration-200">{it.label}</a>
                        ))}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- NBA / Cricket: single-level dropdowns -->
          {simpleDropdowns.map((d) => (
            <div class="relative group/d inline-flex items-center">
              <a href={d.href} class="inline-flex items-center gap-1 px-1 pt-1 text-sm font-bold text-slate-400 hover:text-amber-300 transition-colors duration-200">
                {d.label}
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevronDown}/></svg>
              </a>
              <div class="absolute left-0 top-full pt-3 hidden group-hover/d:block group-focus-within/d:block z-50">
                <div class="bg-[#211d19] border border-[#3c352c] rounded-lg shadow-xl py-2 min-w-[150px]">
                  {d.items.map((it) => (
                    <a href={it.href} class="block px-4 py-2 text-sm font-bold text-slate-300 hover:text-amber-300 hover:bg-[#3c352c] transition-colors duration-200">{it.label}</a>
                  ))}
                </div>
              </div>
            </div>
          ))}

          <HeaderLink href={`/${lang}/strategy`} class="inline-flex items-center px-1 pt-1 text-sm font-bold text-slate-400 hover:text-amber-300 transition-colors duration-200">
            {t('nav.strategy')}
          </HeaderLink>
        </nav>
      </div>
      <div class="flex items-center gap-3">
        <LanguagePicker />
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded-lg text-slate-400 hover:text-amber-300 hover:bg-[#3c352c] transition-colors duration-200"
        >
          <svg id="menu-icon-open" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav (flattened, indented) -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[#3c352c] bg-[#0a150f] max-h-[80vh] overflow-y-auto">
    <nav class="px-4 py-3 space-y-1">
      <a href={`/${lang}/`} class="block px-3 py-2.5 rounded-lg text-sm font-bold text-slate-100 hover:text-amber-300 hover:bg-[#3c352c]">{t('nav.home')}</a>

      <a href={`/${lang}/football`} class="block px-3 py-2.5 rounded-lg text-sm font-black text-slate-200 hover:text-amber-300 hover:bg-[#3c352c]">{t('nav.football')}</a>
      {footballGroups.map((g) => (
        <>
          <a href={g.href} class="block pl-6 pr-3 py-2 rounded-lg text-sm font-bold text-slate-400 hover:text-amber-300 hover:bg-[#3c352c]">{g.label}</a>
          {g.items.map((it) => (
            <a href={it.href} class="block pl-10 pr-3 py-1.5 rounded-lg text-xs font-bold text-slate-500 hover:text-amber-300 hover:bg-[#3c352c]">{it.label}</a>
          ))}
        </>
      ))}

      {simpleDropdowns.map((d) => (
        <>
          <a href={d.href} class="block px-3 py-2.5 rounded-lg text-sm font-black text-slate-200 hover:text-amber-300 hover:bg-[#3c352c]">{d.label}</a>
          {d.items.map((it) => (
            <a href={it.href} class="block pl-6 pr-3 py-1.5 rounded-lg text-xs font-bold text-slate-500 hover:text-amber-300 hover:bg-[#3c352c]">{it.label}</a>
          ))}
        </>
      ))}

      <a href={`/${lang}/strategy`} class="block px-3 py-2.5 rounded-lg text-sm font-bold text-slate-200 hover:text-amber-300 hover:bg-[#3c352c]">{t('nav.strategy')}</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });
</script>
