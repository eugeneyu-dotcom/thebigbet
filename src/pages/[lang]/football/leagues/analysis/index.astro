---
import { languages } from '../../../../../i18n/ui';
import ComingSoon from '../../../../../components/ComingSoon.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const isZhTw = lang === 'zh-tw';
const isTh = lang === 'th';
const tag = isZhTw ? '五大聯賽' : isTh ? '5 ลีกใหญ่' : 'Top 5 Leagues';
const title = isZhTw ? '五大聯賽 賽事分析' : isTh ? 'บทวิเคราะห์ 5 ลีกใหญ่' : 'Top 5 Leagues Analysis';
const message = isZhTw ? '英超、西甲、義甲、德甲、法甲的賽事分析即將推出，敬請期待。' : isTh ? 'บทวิเคราะห์ 5 ลีกใหญ่กำลังจะมาเร็วๆ นี้' : 'Analysis for the top 5 leagues is coming soon.';
---
<ComingSoon lang={lang as string} tag={tag} title={title} message={message} />
