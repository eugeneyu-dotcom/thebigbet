---
import { languages } from '../../../../../i18n/ui';
import ComingSoon from '../../../../../components/ComingSoon.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const isZhTw = lang === 'zh-tw';
const isTh = lang === 'th';
const tag = isZhTw ? '五大聯賽' : isTh ? '5 ลีกใหญ่' : 'Top 5 Leagues';
const title = isZhTw ? '五大聯賽 賽事知識' : isTh ? 'ความรู้ 5 ลีกใหญ่' : 'Top 5 Leagues Guides';
const message = isZhTw ? '五大聯賽的賽事知識與教學內容即將推出，敬請期待。' : isTh ? 'เนื้อหาความรู้ 5 ลีกใหญ่กำลังจะมาเร็วๆ นี้' : 'Guides for the top 5 leagues are coming soon.';
---
<ComingSoon lang={lang as string} tag={tag} title={title} message={message} />
