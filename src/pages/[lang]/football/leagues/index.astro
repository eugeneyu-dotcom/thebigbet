---
import { getCollection } from 'astro:content';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import BaseHead from '../../../../components/BaseHead.astro';
import GoogleAnalytics from '../../../../components/GoogleAnalytics.astro';
import TeamIcon from '../../../../components/TeamIcon.astro';
import { languages, useTeamTranslations } from '../../../../i18n/ui';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const isZhTw = lang === 'zh-tw';
const isTh = lang === 'th';
const tTeam = useTeamTranslations(lang as any);

let leagueMatches: any[] = [];
try {
  const p = path.resolve('src/data/leagueMatches.json');
  if (fs.existsSync(p)) leagueMatches = JSON.parse(fs.readFileSync(p, 'utf8'));
} catch (e) {}
leagueMatches.sort((a, b) => new Date(a.commence_time).getTime() - new Date(b.commence_time).getTime());
const upcoming = leagueMatches.slice(0, 12);

function moneyline(m: any) {
  const h2h = m.bookmakers?.[0]?.markets?.find((k: any) => k.key === 'h2h');
  const home = h2h?.outcomes?.find((o: any) => o.name === m.home_team)?.price ?? '-';
  const away = h2h?.outcomes?.find((o: any) => o.name === m.away_team)?.price ?? '-';
  const draw = h2h?.outcomes?.find((o: any) => o.name === 'Draw')?.price ?? null;
  return { home, away, draw };
}
const fmtTime = (iso: string) =>
  new Date(iso).toLocaleString(lang === 'zh-tw' ? 'zh-TW' : lang === 'th' ? 'th-TH' : 'en-US', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false });

const analysisEntries = (await getCollection('analysis', (entry) =>
  entry.id.startsWith(lang + '/') && entry.data.league === 'club-football'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const title = isZhTw ? '五大聯賽' : isTh ? '5 ลีกใหญ่' : 'Top 5 Leagues';
const metaDescription = isZhTw
  ? '英超、西甲、義甲、德甲、法甲即時賠率與深度賽事分析。'
  : isTh ? 'ราคาสดและบทวิเคราะห์เชิงลึกของพรีเมียร์ลีก ลาลีกา เซเรียอา บุนเดสลีกา และลีกเอิง'
    : 'Live EPL, La Liga, Serie A, Bundesliga and Ligue 1 odds and in-depth match analysis.';
const oddsHeading = isZhTw ? '五大聯賽即時賠率' : isTh ? 'ราคาสด 5 ลีกใหญ่' : 'Live Top 5 Leagues Odds';
const analysisHeading = isZhTw ? '五大聯賽賽事分析' : isTh ? 'วิเคราะห์ 5 ลีกใหญ่' : 'Top 5 Leagues Analysis';
const noOdds = isZhTw ? '目前暫無五大聯賽賠率資料。' : isTh ? 'ยังไม่มีข้อมูลราคา 5 ลีกใหญ่' : 'No Top 5 Leagues odds available right now.';
const noAnalysis = isZhTw ? '目前尚無五大聯賽分析文章。' : isTh ? 'ยังไม่มีบทวิเคราะห์ 5 ลีกใหญ่' : 'No Top 5 Leagues analysis yet.';

const leagueLabel = (sportTitle: string) => {
  const map: Record<string, [string, string]> = {
    'EPL': [isZhTw ? '英超' : isTh ? 'พรีเมียร์ลีก' : 'EPL', ''],
    'La Liga - Spain': [isZhTw ? '西甲' : isTh ? 'ลาลีกา' : 'La Liga', ''],
    'Serie A - Italy': [isZhTw ? '義甲' : isTh ? 'เซเรียอา' : 'Serie A', ''],
    'Bundesliga - Germany': [isZhTw ? '德甲' : isTh ? 'บุนเดสลีกา' : 'Bundesliga', ''],
    'Ligue 1 - France': [isZhTw ? '法甲' : isTh ? 'ลีกเอิง' : 'Ligue 1', ''],
  };
  return map[sportTitle]?.[0] ?? sportTitle;
};
---

<html lang={lang}>
  <head>
    <BaseHead title={`${title} | The Big Bet`} description={metaDescription} lang={lang} />
    <GoogleAnalytics />
  </head>
  <body class="bg-[#0c1a13] text-slate-200 font-sans min-h-screen flex flex-col">
    <Header />
    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow w-full">

      <div class="mb-8">
        <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">{isZhTw ? '足球' : isTh ? 'ฟุตบอล' : 'Football'}</p>
        <h1 class="text-3xl font-black text-white">{title}</h1>
      </div>

      <!-- Odds -->
      <section class="mb-12">
        <h2 class="text-xl font-black text-white mb-4">{oddsHeading}</h2>
        {upcoming.length === 0 ? (
          <p class="text-slate-500 text-sm">{noOdds}</p>
        ) : (
          <ul class="space-y-3">
            {upcoming.map((m) => {
              const ml = moneyline(m);
              return (
                <li class="bg-[#10241a] border border-[#1a3a29] rounded-xl px-5 py-4">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs text-slate-500 font-mono">{fmtTime(m.commence_time)}</span>
                    <span class="text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded bg-violet-400/10 border border-violet-400/30 text-violet-300">{leagueLabel(m.sport_title)}</span>
                  </div>
                  <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3">
                    <div class="min-w-0 flex items-center gap-2">
                      <TeamIcon team={m.away_team} class="w-6 h-6" />
                      <div class="min-w-0">
                        <p class="font-bold text-white truncate">{tTeam(m.away_team)}</p>
                        <p class="text-xs text-slate-500 uppercase">{isZhTw ? '客隊' : isTh ? 'ทีมเยือน' : 'Away'}</p>
                      </div>
                    </div>
                    <div class="flex items-center gap-2 font-mono font-black text-sm">
                      <span class="text-violet-400">{ml.away}</span>
                      {ml.draw && <span class="text-slate-500">{ml.draw}</span>}
                      <span class="text-amber-400">{ml.home}</span>
                    </div>
                    <div class="min-w-0 flex items-center justify-end gap-2 text-right">
                      <div class="min-w-0">
                        <p class="font-bold text-white truncate">{tTeam(m.home_team)}</p>
                        <p class="text-xs text-slate-500 uppercase">{isZhTw ? '主隊' : isTh ? 'เจ้าบ้าน' : 'Home'}</p>
                      </div>
                      <TeamIcon team={m.home_team} class="w-6 h-6" />
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </section>

      <!-- Analysis -->
      <section>
        <h2 class="text-xl font-black text-white mb-4">{analysisHeading}</h2>
        {analysisEntries.length === 0 ? (
          <p class="text-slate-500 text-sm">{noAnalysis}</p>
        ) : (
          <ul class="space-y-4">
            {analysisEntries.map((entry) => {
              const [, ...slugParts] = entry.id.split('/');
              const slug = slugParts.join('/');
              return (
                <li>
                  <a href={`/${lang}/football/leagues/analysis/${slug}`} class="group block bg-[#10241a] border border-[#1a3a29] hover:border-amber-400/40 rounded-2xl p-6 transition-all duration-200">
                    <time class="text-xs text-slate-500 font-mono">{entry.data.pubDate.toLocaleDateString(lang === 'zh-tw' ? 'zh-TW' : lang === 'th' ? 'th-TH' : 'en-US')}</time>
                    <h3 class="text-lg font-bold text-white group-hover:text-amber-300 transition-colors duration-200 truncate mt-2">{entry.data.title}</h3>
                    {entry.data.prediction && (
                      <p class="text-sm font-bold text-amber-400 mt-2">{isZhTw ? '預測：' : isTh ? 'ทำนาย: ' : 'Prediction: '}{entry.data.prediction}</p>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>

    </main>
    <Footer />
  </body>
</html>
