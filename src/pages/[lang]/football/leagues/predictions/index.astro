---
import { getCollection } from 'astro:content';
import { languages } from '../../../../../i18n/ui';
import TrendList from '../../../../../components/TrendList.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const isZhTw = lang === 'zh-tw';
const isTh = lang === 'th';

const entries = await getCollection('predictions', (entry) =>
  entry.id.startsWith(lang + '/') && entry.data.league === 'club-football');

const metaTitle = isZhTw ? '五大聯賽賽事預測 | The Big Bet' : isTh ? 'ทำนายผล 5 ลีกใหญ่ | The Big Bet' : 'Top 5 Leagues Predictions | The Big Bet';
const metaDescription = isZhTw
  ? '五大聯賽近期賽事的即時預測，聚焦焦點球隊每輪對戰。'
  : isTh ? 'ทำนายผลนัดล่าสุดของ 5 ลีกใหญ่ เจาะทีมโฟกัสในแต่ละสัปดาห์'
    : 'Round-by-round predictions for Top 5 Leagues fixtures, focused on the priority clubs.';
const tag = isZhTw ? '五大聯賽' : isTh ? '5 ลีกใหญ่' : 'Top 5 Leagues';
const heading = isZhTw ? '五大聯賽賽事預測' : isTh ? 'ทำนายผล 5 ลีกใหญ่' : 'Top 5 Leagues Predictions';
const intro = isZhTw
  ? '不是球隊整季走向的觀察，而是針對近期即將開踢的對戰給出的即時預測。'
  : isTh ? 'ไม่ใช่มุมมองทิศทางทีมตลอดฤดูกาล แต่เป็นการทำนายผลนัดที่กำลังจะแข่งในเร็ว ๆ นี้'
    : 'Not season-long team commentary — quick predictions for fixtures coming up soon.';
const emptyText = isZhTw ? '目前尚無五大聯賽賽事預測文章，敬請期待。' : isTh ? 'ยังไม่มีบทความทำนายผล 5 ลีกใหญ่ โปรดกลับมาใหม่' : 'No Top 5 Leagues predictions yet. Check back soon.';
---

<TrendList
  lang={lang as string}
  entries={entries}
  basePath={`/${lang}/football/leagues/predictions`}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  tag={tag}
  heading={heading}
  intro={intro}
  emptyText={emptyText}
/>
