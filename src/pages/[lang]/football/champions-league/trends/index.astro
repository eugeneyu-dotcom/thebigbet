---
import { getCollection } from 'astro:content';
import { languages } from '../../../../../i18n/ui';
import TrendList from '../../../../../components/TrendList.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const isZhTw = lang === 'zh-tw';
const isTh = lang === 'th';

const entries = await getCollection('trends', (entry) =>
  entry.id.startsWith(lang + '/') && entry.data.league === 'champions-league');

const metaTitle = isZhTw ? '歐冠趨勢分析 | The Big Bet' : isTh ? 'วิเคราะห์เทรนด์แชมเปียนส์ลีก | The Big Bet' : 'Champions League Trend Analysis | The Big Bet';
const metaDescription = isZhTw
  ? '歐冠球隊整季戰力趨勢分析：陣容補強、戰績走勢與爭冠形勢。'
  : isTh ? 'วิเคราะห์เทรนด์ทีมในแชมเปียนส์ลีกตลอดฤดูกาล: การเสริมทัพ ฟอร์ม และการลุ้นแชมป์'
    : 'Champions League team season trend analysis: transfers, form, and title-race outlook.';
const tag = isZhTw ? '歐冠' : isTh ? 'แชมเปียนส์ลีก' : 'Champions League';
const heading = isZhTw ? '歐冠趨勢分析' : isTh ? 'วิเคราะห์เทรนด์แชมเปียนส์ลีก' : 'Champions League Trend Analysis';
const intro = isZhTw
  ? '不是單場比賽前瞻，而是球隊整季戰力走向的觀察與評論。'
  : isTh ? 'ไม่ใช่การวิเคราะห์รายนัด แต่เป็นมุมมองต่อทิศทางทีมตลอดฤดูกาล'
    : 'Not a single-game preview — season-long commentary on where a team is headed.';
const emptyText = isZhTw ? '目前尚無歐冠趨勢分析文章，敬請期待。' : isTh ? 'ยังไม่มีบทวิเคราะห์เทรนด์แชมเปียนส์ลีก โปรดกลับมาใหม่' : 'No Champions League trend analysis yet. Check back soon.';
---

<TrendList
  lang={lang as string}
  entries={entries}
  basePath={`/${lang}/football/champions-league/trends`}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  tag={tag}
  heading={heading}
  intro={intro}
  emptyText={emptyText}
/>
