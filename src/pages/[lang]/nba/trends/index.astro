---
import { getCollection } from 'astro:content';
import { languages } from '../../../../i18n/ui';
import TrendList from '../../../../components/TrendList.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const isZhTw = lang === 'zh-tw';
const isTh = lang === 'th';

const entries = await getCollection('trends', (entry) =>
  entry.id.startsWith(lang + '/') && entry.data.league === 'nba');

const metaTitle = isZhTw ? 'NBA 趨勢分析 | The Big Bet' : isTh ? 'วิเคราะห์เทรนด์ NBA | The Big Bet' : 'NBA Trend Analysis | The Big Bet';
const metaDescription = isZhTw
  ? 'NBA 球隊整季戰力趨勢分析：陣容、戰績走勢與爭冠形勢。'
  : isTh ? 'วิเคราะห์เทรนด์ทีม NBA ตลอดฤดูกาล: ผู้เล่น ฟอร์ม และการลุ้นแชมป์'
    : 'NBA team season trend analysis: roster, form, and title-race outlook.';
const tag = 'NBA';
const heading = isZhTw ? 'NBA 趨勢分析' : isTh ? 'วิเคราะห์เทรนด์ NBA' : 'NBA Trend Analysis';
const intro = isZhTw
  ? '不是單場比賽前瞻，而是整季戰力走向的觀察與評論。'
  : isTh ? 'ไม่ใช่การวิเคราะห์รายนัด แต่เป็นมุมมองต่อทิศทางทีมตลอดฤดูกาล'
    : 'Not a single-game preview — season-long commentary on where a team is headed.';
const emptyText = isZhTw ? '目前尚無 NBA 趨勢分析文章，敬請期待。' : isTh ? 'ยังไม่มีบทวิเคราะห์เทรนด์ NBA โปรดกลับมาใหม่' : 'No NBA trend analysis yet. Check back soon.';
---

<TrendList
  lang={lang as string}
  entries={entries}
  basePath={`/${lang}/nba/trends`}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  tag={tag}
  heading={heading}
  intro={intro}
  emptyText={emptyText}
/>
