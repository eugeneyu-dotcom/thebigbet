---
import { languages } from '../../../../i18n/ui';
import ComingSoon from '../../../../components/ComingSoon.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const isZhTw = lang === 'zh-tw';
const isTh = lang === 'th';
const tag = isZhTw ? '板球' : isTh ? 'คริกเก็ต' : 'Cricket';
const title = isZhTw ? '板球賽事知識' : isTh ? 'ความรู้คริกเก็ต' : 'Cricket Guides';
const message = isZhTw ? '板球賽事知識與教學內容即將推出，敬請期待。' : isTh ? 'เนื้อหาความรู้คริกเก็ตกำลังจะมาเร็วๆ นี้' : 'Cricket guides and explainers are coming soon.';
---
<ComingSoon lang={lang as string} tag={tag} title={title} message={message} />
