---
import { getCollection, render } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BaseHead from '../../components/BaseHead.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleAdsense from '../../components/GoogleAdsense.astro';

// Site-information pages (about, editorial policy, privacy, contact,
// responsible gambling) from the `pages` collection: /{lang}/{slug}/
export async function getStaticPaths() {
  const entries = await getCollection('pages');
  return entries.map((entry) => {
    const [lang, ...slugParts] = entry.id.split('/');
    return { params: { lang, page: slugParts.join('/') }, props: { entry } };
  });
}

const { lang } = Astro.params;
const { entry } = Astro.props;
const { Content } = await render(entry);
const updatedLabel = lang === 'zh-tw' ? '最後更新' : lang === 'th' ? 'อัปเดตล่าสุด' : lang === 'bn' ? 'সর্বশেষ হালনাগাদ' : 'Last updated';
const updatedDate = entry.data.updated.toLocaleDateString(
  lang === 'zh-tw' ? 'zh-TW' : lang === 'th' ? 'th-TH-u-ca-gregory' : lang === 'bn' ? 'bn-BD' : 'en-US',
  { timeZone: 'UTC' }
);
---

<html lang={lang}>
  <head>
    <BaseHead title={`${entry.data.title} | The Big Bet`} description={entry.data.description} lang={lang} />
    <GoogleAnalytics />
    <GoogleAdsense />
  </head>
  <body class="bg-[#0a150f] text-slate-200 font-sans min-h-screen flex flex-col">
    <Header />
    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow min-w-0 w-full">
      <article class="bg-[#211d19] rounded-2xl shadow-lg border border-[#3c352c] p-6 sm:p-8">
        <header class="mb-8">
          <h1 class="text-3xl md:text-4xl font-black text-white leading-tight">{entry.data.title}</h1>
          <p class="mt-3 text-sm text-slate-400 font-mono">{updatedLabel}：{updatedDate}</p>
        </header>
        <div class="article-body prose prose-invert max-w-none prose-headings:font-black prose-headings:text-white prose-a:text-amber-400 prose-strong:text-white">
          <Content />
        </div>
        <style>
          .article-body p { color: rgb(203 213 225); line-height: 1.875; }
          .article-body h2 { font-size: 1.2rem; margin-top: 2.5rem; margin-bottom: 0.75rem; padding-left: 1rem; border-left: 4px solid rgb(245 158 11); color: #fff; }
          .article-body li { color: rgb(203 213 225); }
          .article-body a { text-decoration: none; }
        </style>
      </article>
    </main>
    <Footer />
  </body>
</html>
